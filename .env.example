APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG=single
APP_LOG_LEVEL=error
APP_NAME=NSL-QUIZ
APP_URL=https://quizfunz.com

CDN_URL=https://nsl-quiz.oss-accelerate.aliyuncs.com/

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=history_quiz
DB_USERNAME=root
DB_PASSWORD=

OSS_ACCESS_ID=
OSS_ACCESS_KEYS=
OSS_BUCKET=nsl-quiz
OSS_ANSWERS_BUCKET=nsl-quiz-answers
OSS_REPORTS_BUCKET=
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_DRIVER=redis

# Cache Setting
GLOBAL_CACHE=30
PAGE_CACHE=5
REFERENCE_CACHE=5
POST_CACHE=5
AD_CACHE=5

SESSION_DRIVER=redis
SESSION_LIFETIME=2880
SESSION_DOMAIN=.app

# Redis standalone server
#REDIS_HOST=127.0.0.1
# Redis cluster server
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DATABASE_MEMBERSHIP=0
REDIS_DATABASE_DEFAULT=1
REDIS_DATABASE_PAPER=2
REDIS_DATABASE_USER_STAT=3
REDIS_DATABASE_QUEUE=4
REDIS_DATABASE_HORIZON=5

HORIZON_PREFIX={NSL-QUIZ}

MAIL_DRIVER=mailgun
MAIL_FROM_ADDRESS=no-reply@quizfunz.com
MAIL_FROM_NAME="QuizFunZ"

# Mailgun settings
#MAILGUN_DOMAIN=mg.quizfunz.com
#MAILGUN_SECRET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ADMIN_HTTPS=true

# Google Recaptcha v2
GOOGLE_RECAPTCHA_V2_SITE_KEY=
GOOGLE_RECAPTCHA_V2_SECRET_KEY=

# Google Recaptcha v3
GOOGLE_RECAPTCHA_SECRET_KEY=
GOOGLE_RECAPTCHA_SITE_KEY=

# Sentry dsn
#MIX_SENTRY_DSN=

SEND_DAILY_REPORT=false

RANKING_PREVIEW_KEY=

QUIZ_ID=
QUIZ_TARGET='secondary'
QUIZ_API_URL=https://api.quizfunz.com
QUIZ_PROFILE_EDIT_URL=https://quizfunz.com/user/profile/edit

SSO_URL=https://sso.quizfunz.com
SSO_ACCESS_KEY=
SSO_ACCESS_SECRET=
SSO_CALLBACK_URL=
